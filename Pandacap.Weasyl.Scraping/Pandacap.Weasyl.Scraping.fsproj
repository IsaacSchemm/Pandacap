  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pandacap.Weasyl.Scraping.Interfaces\Pandacap.Weasyl.Scraping.Interfaces.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="11.0.101" />
  </ItemGroup>

</Project>
